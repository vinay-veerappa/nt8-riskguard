<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <DefineConstants>TESTING</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Include all addon .cs files EXCEPT RiskManagerAddOn.cs (superseded by
         RiskGuardAddOn.cs; compiling both duplicates types).
         There is no exclusion for McpBridgeAddOn.cs because that file is not in
         this repo at all. It lives in nt8-mcp-bridge, which vendors this repo
         and owns its own harness (see docs/NT8_REPO_SPLIT_PLAN.md section 5). -->
    <Compile Include="..\addons\*.cs" Link="%(Filename)%(Extension)" />
    <Compile Remove="..\addons\RiskManagerAddOn.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
